# Cloud PostgreSQL. Paste the pooled connection string from Supabase / Neon / Railway / Render.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
PORT=3000
HOST="127.0.0.1"

# Volcengine Ark / Doubao multimodal vision model.
AI_API_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
AI_API_KEY=""
AI_MODEL="doubao-seed-1-6-vision-250815"
AI_RESPONSE_FORMAT_JSON=false

# AMap / Gaode official Web Service API.
AMAP_API_BASE_URL="https://restapi.amap.com"
AMAP_API_KEY=""

DEFAULT_USER_ID="demo-user"
LOCATION_QUEST_COOLDOWN_SECONDS=600
